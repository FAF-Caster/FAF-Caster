<Window x:Class="FAF.Caster.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="FAF Caster" Width="1300" Height="850" MinWidth="900" MinHeight="580" Background="#0B1522" Closing="OnClosing">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#142537" Padding="16,12" BorderBrush="#294054" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="◈" FontSize="24" Foreground="#5DE2DC" Margin="0,0,10,0"/>
     <StackPanel><TextBlock Text="FAF CASTER" FontSize="18" FontWeight="Bold" Foreground="#ECF9FF"/><TextBlock Text="DESKTOP COMPANION" FontSize="10" Foreground="#8CAAB9"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Button Content="Companion" Click="Companion_Click" Style="{StaticResource NavButton}" Margin="0,0,10,0"/>
     <Button Content="Overlay Studio" Click="Studio_Click" Style="{StaticResource NavButton}" Margin="0,0,10,0"/>
     <Button Content="OBS overlay ↗" Click="Obs_Click" Style="{StaticResource NavButton}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="GameStatus" Text="FAF: checking" Foreground="#C4D7E5" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <TextBlock x:Name="Status" Text="Bridge starting…" Foreground="#5DE2DC" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <Button Content="Reconnect" Click="Retry_Click" Style="{StaticResource NavButton}"/>
    </StackPanel>
   </Grid>
  </Border>
  <wv2:WebView2 x:Name="Browser"/>
 </DockPanel>
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Background" Value="#223C50"/>
   <Setter Property="Foreground" Value="#EDF8FF"/>
   <Setter Property="BorderBrush" Value="#36586C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#315C6E"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
</Window>