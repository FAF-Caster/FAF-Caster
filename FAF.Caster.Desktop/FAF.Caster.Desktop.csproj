<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AssemblyName>FAF.Caster.Desktop</AssemblyName>
    <ApplicationIcon>Assets/FAF-Caster.ico</ApplicationIcon>
    <Version>26.11.0</Version>
    <AssemblyVersion>26.11.0.0</AssemblyVersion>
    <FileVersion>26.11.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/FAF-Caster.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
</Project>