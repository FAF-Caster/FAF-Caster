{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faf-caster-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "CasterSession" }, { "name": "CODES", "class_name": "LinkRegistry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CasterSession"] }, { "tag": "v2", "new_sqlite_classes": ["LinkRegistry"] }]
}
